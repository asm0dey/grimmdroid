default_platform(:android)

platform :android do
  desc "Merge gate: formatting, lint and unit tests"
  lane :test do
    gradle(tasks: ["spotlessCheck", "lint", "testDebugUnitTest"])
  end

  desc "Build a signed release APK, AAB and APK set (signing from GRIMMDROID_* env vars)"
  lane :release do
    %w[GRIMMDROID_KEYSTORE GRIMMDROID_KEYSTORE_PASSWORD GRIMMDROID_KEY_ALIAS GRIMMDROID_KEY_PASSWORD].each do |name|
      UI.user_error!("#{name} is not set") if ENV[name].to_s.empty?
    end
    gradle(tasks: ["assembleRelease", "buildApksRelease"])
  end
end
